{
  "name": "@tabward/mcp",
  "version": "0.4.0",
  "description": "Local MCP server for the TabWard Chrome extension",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tabward-mcp": "dist/index.js",
    "tabward-broker": "dist/broker-server.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node ../../scripts/sync-package-meta.mjs && npm run build",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
